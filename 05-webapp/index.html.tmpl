<!-- =============================================================================
 index.html
 Client for the OCI Keygen API.

 Layout note: the page is a full-height flex column and NEVER scrolls itself.
 The two key panels flex to fill whatever space is left and scroll internally,
 so a 50-line RSA-4096 private key and a 3-line Ed25519 key both sit in the
 same frame with no manual resizing and no layout shift between runs.
============================================================================= -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="dark" />
<title>Key Generator</title>
<style>
/* ---------------------------------------------------------------------------
   Palette — matches the video's title cards so a cut from the app to a slide
   is a tonal match rather than a white-to-black flash.
   --------------------------------------------------------------------------- */
:root {
  --bg:     #0A0E14;
  --panel:  #121A24;
  --border: #223142;
  --text:   #E6EDF3;
  --muted:  #8FA0B4;
  --gold:   #F5B700;
}

* { box-sizing: border-box; }

html, body { height: 100%; }

/* Belt-and-braces: flex items will not shrink below their min-content width
   unless told to, which is how a long unbroken key string turns into sideways
   scroll. word-break already prevents it here; this keeps it true if the
   markup or content changes. */
body > *, .controls > *, .panel > * { min-width: 0; }

/* Type scales with the viewport: sized to stay legible when a 1080p screen
   recording is watched full-frame on a phone, not for phone browsing. */
body {
  margin: 0;
  padding: clamp(14px, 2.5vw, 28px);
  /* Fixed height + hidden overflow, NOT min-height: min-height lets the body
     grow past the viewport and the page scrolls again, which is the exact
     thing this layout exists to prevent. */
  height: 100dvh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: clamp(10px, 1.6vh, 18px);
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  font-size: clamp(16px, 1.15vw, 21px);
  line-height: 1.4;
}

h1 {
  margin: 0;
  font-size: clamp(1.5rem, 2.6vw, 2.3rem);
  font-weight: 700;
  letter-spacing: -0.01em;
}

/* Controls sit on one row so the fold stays shallow and the status line —
   the number this whole demo exists to show — stays high in frame. */
.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: clamp(10px, 1.5vw, 16px);
}

.controls label { color: var(--muted); font-weight: 600; }

select, button {
  font: inherit;
  border-radius: 8px;
  border: 1px solid var(--border);
  padding: 0.55em 0.9em;
}

select {
  background: var(--panel);
  color: var(--text);
}

#generateBtn {
  background: var(--gold);
  border-color: var(--gold);
  color: #10131A;
  font-weight: 700;
  cursor: pointer;
}

#generateBtn:hover { filter: brightness(1.08); }

/* The elapsed time is the hero of the shot — oversized and gold so it reads
   at phone scale. min-height reserves its line so nothing jumps when it fills. */
#status {
  min-height: 1.5em;
  font-size: clamp(1.15rem, 1.9vw, 1.7rem);
  font-weight: 700;
  color: var(--gold);
  font-variant-numeric: tabular-nums;
}

/* Public key gets 1 share of the leftover height, private key 3 — a wrapped
   RSA-4096 public key needs about four lines, the matching private key about
   fifty, so this keeps both boxes mostly full rather than one padded with
   dead space and the other clipped. */
.panel {
  display: flex;
  flex-direction: column;
  min-height: 0;              /* lets the textarea shrink inside the flex row */
  gap: 6px;
}
.panel.pub  { flex: 1 1 0; }
.panel.priv { flex: 3 1 0; }

.panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}

.panel-head h2 {
  margin: 0;
  font-size: clamp(0.95rem, 1.2vw, 1.15rem);
  font-weight: 600;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* Copy sits on the heading row, not below the box — keeps it off the vertical
   budget so the panels get the space instead. */
.copy-btn {
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  padding: 0.3em 0.7em;
  font-size: 0.8em;
}
.copy-btn:hover { color: var(--text); border-color: var(--muted); }

textarea {
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  resize: none;               /* the flex layout sizes these, not the user */
  overflow: auto;
  padding: clamp(10px, 1.2vw, 16px);
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--panel);
  color: var(--text);
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: clamp(0.8rem, 0.95vw, 1rem);
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-all;
}

textarea:focus { outline: 1px solid var(--gold); }

/* Stack the controls on narrow screens so nothing is squeezed unreadable. */
@media (max-width: 560px) {
  .controls { flex-direction: column; align-items: stretch; }
  #generateBtn { width: 100%; }
}
</style>
</head>
<body>

<h1>Generate SSH Keypair</h1>

<div class="controls">
  <label for="keyType">Key type</label>
  <select id="keyType">
    <option value="rsa-2048">RSA 2048-bit</option>
    <option value="rsa-4096">RSA 4096-bit</option>
    <option value="ed25519">Ed25519</option>
  </select>
  <button id="generateBtn">Generate Keypair</button>
</div>

<div id="status"></div>

<!-- -----------------------------------------------------------------------------
 Public Key Section
----------------------------------------------------------------------------- -->
<section class="panel pub">
  <div class="panel-head">
    <h2>Public Key</h2>
    <button class="copy-btn"
      onclick="navigator.clipboard.writeText(document.getElementById('pubKey').value)">
      Copy
    </button>
  </div>
  <textarea id="pubKey" readonly></textarea>
</section>

<!-- -----------------------------------------------------------------------------
 Private Key Section
----------------------------------------------------------------------------- -->
<section class="panel priv">
  <div class="panel-head">
    <h2>Private Key</h2>
    <button class="copy-btn"
      onclick="navigator.clipboard.writeText(document.getElementById('privKey').value)">
      Copy
    </button>
  </div>
  <textarea id="privKey" readonly></textarea>
</section>

<script>
// -----------------------------------------------------------------------------
// Utility: sleep
// -----------------------------------------------------------------------------
const sleep = ms => new Promise(r => setTimeout(r, ms));

// -----------------------------------------------------------------------------
// Poll schedule
// -----------------------------------------------------------------------------
// The first read fires immediately and early retries are 250ms apart: the VM
// consumer often finishes before a slower tick could observe it, and a fixed
// delay would report latency the backend never actually had.  Intervals widen
// after 3s so the long wait in SCH mode doesn't hammer the API.
//
// The deadline must exceed Connector Hub's batch time limit (60s default) or
// SCH mode reports a timeout instead of a measurement.
// -----------------------------------------------------------------------------
const POLL_DEADLINE_MS = 120000;
const pollDelay = elapsed => (elapsed < 3000 ? 250 : 1000);

// -----------------------------------------------------------------------------
// Keep-alive: ping /heartbeat once a minute so the result (polling) function
// stays warm between requests. OCI Functions cold-start on first invocation;
// this keeps the get function hot so polling doesn't pay that penalty.
// -----------------------------------------------------------------------------
setInterval(() => { fetch(`${API_BASE}/heartbeat`).catch(() => {}); }, 60000);

// -----------------------------------------------------------------------------
// Generate Keypair handler
// -----------------------------------------------------------------------------
document.getElementById("generateBtn").onclick = async () => {
  const sel = document.getElementById("keyType").value;
  const [type, bits] = sel.split("-");
  document.getElementById("status").textContent = "Requesting keypair...";

  // Clear the previous run's keys before waiting.  Leaving them on screen
  // makes a pending request look already-complete — misleading in the UI and
  // actively wrong on camera, where the fill-in is the visible proof of work.
  document.getElementById("pubKey").value = "";
  document.getElementById("privKey").value = "";

  // Clock starts at the click, not at the fetch — this measures what the user
  // actually waits for, which is the number the VM-vs-SCH comparison is about.
  const t0 = performance.now();

  try {
    // -----------------------------------------------------------
    // Step 1: POST /keygen
    // -----------------------------------------------------------
    const resp = await fetch(`${API_BASE}/keygen`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ key_type: type, key_bits: Number(bits) })
    });
    const data = await resp.json();
    const id = data.request_id;

    const tQueued = performance.now();
    console.log(`[timing] enqueue (POST /keygen 202): ` +
                `${(tQueued - t0).toFixed(0)}ms — id ${id}`);

    document.getElementById("status").textContent =
      `Request ID: ${id} (waiting...)`;

    // -----------------------------------------------------------
    // Step 2: Poll /result/{id}
    // -----------------------------------------------------------
    let ready = false, result, polls = 0;
    const deadline = t0 + POLL_DEADLINE_MS;

    while (performance.now() < deadline) {
      const res = await fetch(`${API_BASE}/result/${id}`);
      result = await res.json();
      polls++;
      if (result.status !== "pending") { ready = true; break; }
      await sleep(pollDelay(performance.now() - t0));
    }

    // -----------------------------------------------------------
    // Step 3: Display results
    // -----------------------------------------------------------
    if (ready) {
      const total = performance.now() - t0;
      // Processing time is quantised by the poll interval, so it is an upper
      // bound: the worker finished somewhere inside the last poll gap.
      console.log(`[timing] key received: ${total.toFixed(0)}ms total ` +
                  `(${polls} poll${polls === 1 ? "" : "s"})`);
      console.log(`[timing]   enqueue ${(tQueued - t0).toFixed(0)}ms + ` +
                  `process/poll ${(performance.now() - tQueued).toFixed(0)}ms ` +
                  `(+/- one poll interval)`);

      document.getElementById("status").textContent =
        `Keypair ready in ${(total / 1000).toFixed(2)}s`;
      document.getElementById("pubKey").value = atob(result.public_key_b64);
      document.getElementById("privKey").value = atob(result.private_key_b64);
    } else {
      const total = performance.now() - t0;
      console.log(`[timing] TIMED OUT after ${total.toFixed(0)}ms ` +
                  `(${polls} polls)`);
      document.getElementById("status").textContent =
        `Timed out after ${(total / 1000).toFixed(0)}s.`;
    }
  } catch (err) {
    console.log(`[timing] failed after ` +
                `${(performance.now() - t0).toFixed(0)}ms: ${err.message}`);
    document.getElementById("status").textContent =
      "Error: " + err.message;
  }
};
</script>
</body>
</html>
