#cloud-config
# ==============================================================================
# KeyGen worker bootstrap
# ==============================================================================
# Installs the OCI SDK + cryptography, drops the consumer daemon and its config,
# and runs it under systemd (auto-restart).  Auth is via instance principals —
# no credentials are written to the box.
# ==============================================================================
write_files:
  # The consumer daemon (base64 to avoid YAML indentation pitfalls).
  - path: /opt/keygen/consumer.py
    permissions: '0755'
    encoding: b64
    content: ${consumer_b64}

  # Runtime config consumed by the systemd unit's EnvironmentFile.
  - path: /etc/keygen/keygen.env
    permissions: '0644'
    content: |
      QUEUE_ID=${queue_id}
      QUEUE_ENDPOINT=${queue_endpoint}
      NOSQL_TABLE_NAME=${nosql_table_name}
      COMPARTMENT_ID=${compartment_id}
      OCI_REGION=${region}

  - path: /etc/systemd/system/keygen-worker.service
    permissions: '0644'
    content: |
      [Unit]
      Description=OCI KeyGen queue consumer
      After=network-online.target
      Wants=network-online.target

      [Service]
      EnvironmentFile=/etc/keygen/keygen.env
      ExecStart=/opt/keygen/venv/bin/python /opt/keygen/consumer.py
      Restart=always
      RestartSec=5
      User=root

      [Install]
      WantedBy=multi-user.target

runcmd:
  # Install into a venv, NOT the system Python. On Ubuntu 24.04 a system-wide
  # pip install fails: oci needs a newer urllib3, and pip cannot uninstall the
  # apt-managed urllib3 (no RECORD file) even with --break-system-packages. A
  # venv sidesteps PEP 668 and the apt-vs-pip conflict entirely.
  #
  # Retry apt update+install in a bounded loop: on a flaky boot the mirror/index
  # isn't ready when this first runs, which surfaced as "python3.12-venv has no
  # installation candidate" and left the venv without pip. Retrying defeats that
  # transience deterministically instead of relying on boot timing. Name the
  # versioned package (24.04 = 3.12) so it never depends on the metapackage.
  - |
    for i in $(seq 1 30); do
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y python3.12-venv && break
      echo "apt attempt $i failed — retrying in 10s"; sleep 10
    done
  - python3 -m venv /opt/keygen/venv
  # Retry the pip install too — same transient-network reasoning as apt above.
  - |
    for i in $(seq 1 30); do
      /opt/keygen/venv/bin/pip install --no-cache-dir oci cryptography && break
      echo "pip attempt $i failed — retrying in 10s"; sleep 10
    done
  # The OCI Ubuntu image's default iptables only allows SSH inbound; open the
  # health port (the OCI Security List rule alone isn't enough — two firewalls).
  - iptables -I INPUT -p tcp --dport 8080 -j ACCEPT
  - netfilter-persistent save || true
  - systemctl daemon-reload
  - systemctl enable --now keygen-worker.service
